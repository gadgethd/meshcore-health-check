    "maplibre-gl": "6.16.0",
    "mqtt": "^5.16.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "proxy-addr": "^2.0.7"
  },
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  }
