# After editing .env, recreate the Compose service; restart does not reload env_file.
# With the intended image already built/pulled:
# docker compose up -d --no-build --pull never --force-recreate mesh-health-check

# App
PORT=3090
APP_TITLE=Mesh Health Check
APP_EYEBROW=MeshCore Observer Coverage
APP_HEADLINE=Check your mesh reach.
APP_DESCRIPTION=Generate a test code, send it to the configured channel, and watch observer coverage build in real time.
# Also identifies this deployment in server-side OpenStreetMap tile requests.
SITE_URL=
CORESCOPE_URL=
# Optional public CARTO browser key for Dark Matter raster tiles. Leave blank
# for keyless OpenFreeMap dark tiles. Light maps always use OpenStreetMap.
# CARTO tile requests send only the site origin for hostname authorization.
CARTO_BASEMAP_KEY=
EXTERNAL_LINK_URL=
EXTERNAL_LINK_LABEL=
LOG_LEVEL=info
# Set to 1 behind one trusted reverse proxy, or false for direct access.
TRUST_PROXY=1
# Distance unit for packet paths, nearby radii and nearby distance labels: mi or km.
DISTANCE_UNIT=mi
# Prefix for generated test codes, 1-8 letters or digits, e.g. MHC-1A2B3C.
CODE_PREFIX=MHC
# Default nearby radius in DISTANCE_UNIT: 5,10,15,20,25,50,75,100,150,200 only
NEARBY_DEFAULT_RADIUS=100
# Offer opt-in browser location. False keeps map-center and manual selection.
# Recreate the Compose service after editing .env; restart alone won't reload it.
BROWSER_LOCATION_ENABLED=true

# Observer names
OBSERVERS_FILE=data/observer.json
RESULTS_FILE=data/session-results.json

# Region detection — point the server at a GeoJSON FeatureCollection to enable
# region filter buttons in the observer panel. Granularity is determined by the
# boundary file: use regions/uk.geojson for UK regions, regions/us-states.geojson
# for US state-level filtering, regions/us-places.geojson for US city/place-level
# filtering, regions/de-bundeslaender.geojson for Germany, etc.
# Bundled files also include a group property so larger countries show a
# two-level filter in the UI, for example England -> South East,
# US division -> Pacific, or US state -> Boston.
# Leave blank to disable region detection entirely.
# REGIONS_FILE=regions/us-states.geojson
# REGION_NAME_PROPERTY=name
# REGION_GROUP_PROPERTY=group
# Website scope: exact comma-separated GeoJSON labels, union semantics.
# Blank both for unrestricted; enabled scope excludes unknown locations.
# Example: ALLOWED_REGION_GROUPS=New England (requires REGIONS_FILE).
ALLOWED_REGION_GROUPS=
ALLOWED_REGIONS=
# Initial/reload geographic default; one exact GeoJSON region label, blank disables.
# When set, activity ranking in this region takes precedence over KNOWN_OBSERVERS.
INITIAL_REGION=

# MQTT
MQTT_HOST=mqtt.example.net
MQTT_PORT=443
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=meshcore/SITE/#
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/
MQTT_TLS=true
MQTT_CLIENT_ID=
DASH_BROKER_HOST=

# Optional full MQTT URL override, for example:
# MQTT_URL=wss://host.example:443/mqtt
MQTT_URL=

# Optional repo-local channel file. Leave blank to use TEST_CHANNEL_SECRET only.
CHANNELS_FILE=

# Test channel
TEST_CHANNEL_NAME=test-channel
TEST_CHANNEL_SECRET=
TEST_CHANNEL_HASH=

# Session behavior
# True shows a Code length slider: 6-16 hex characters after MHC-, initially 6.
# False hides it and enforces 6 server-side. Only newly generated codes change.
# Recreate the Compose service after editing .env; restart alone won't reload it.
ALLOW_LONGER_TEST_CODES=false
# Optional MeshCore routing-scope YAML, separate from geographic map regions.
# Blank disables name matching. Copy region-scopes.example.yml to region-scopes.yml
# and add your own quoted public names. Mount the configured container path
# read-only; see HOWTO. No registry is shipped/fetched; private keys unsupported.
MESHCORE_REGION_SCOPES_FILE=
SESSION_TTL_SECONDS=600
RESULT_RETENTION_SECONDS=604800
MAX_USES_PER_CODE=3
SESSION_RATE_WINDOW_SECONDS=600
SESSION_RATE_MAX=30
MAX_RATE_LIMIT_BUCKETS=10000

# Default observer target
# Comma-separated full pubkeys. Leave blank to auto-select the most active
# observers seen in recent packet history, with the active observer window used
# only as a final fallback when no history exists yet.
# Fixed keys apply only when INITIAL_REGION is blank; Default Set restores them.
# Otherwise Default Set ranks the selected region, capped by OBSERVER_TOP_COUNT.
KNOWN_OBSERVERS=
OBSERVER_ACTIVITY_FILE=data/observer-activity.json
OBSERVER_TOP_WINDOW_DAYS=7
OBSERVER_TOP_COUNT=10
# Observer hash prefix width in the UI: 1=AB, 2=ABCD, 3=ABCDEF.
OBSERVER_HASH_DISPLAY_BYTES=1
OBSERVER_ACTIVE_WINDOW_SECONDS=900
# Set to 0 to disable stale-observer pruning from the dashboard/map.
OBSERVER_RETENTION_SECONDS=0
OBSERVER_ACTIVITY_RETENTION_DAYS=30
MAX_OBSERVER_ENTRIES=10000

# Authenticated, same-origin, broadcast-only WebSocket endpoint.
WEBSOCKET_PATH=/
WEBSOCKET_ALLOWED_ORIGINS=
WEBSOCKET_TOKEN_COOKIE_NAME=mesh_health_turnstile_ws
WEBSOCKET_TOKEN_TTL_SECONDS=60
WEBSOCKET_GLOBAL_CAP=200
WEBSOCKET_PER_IP_CAP=5
WEBSOCKET_MAX_PAYLOAD_BYTES=16384
WEBSOCKET_MAX_BUFFERED_AMOUNT_BYTES=1048576
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=30
WEBSOCKET_IDLE_TIMEOUT_SECONDS=90
RATE_LIMIT_BUCKET_MAX=10000
WS_CONNECTION_RATE_WINDOW_SECONDS=60
WS_CONNECTION_RATE_MAX=6000
# Older MAX_WS_* bounds and WS_ALLOWED_ORIGINS remain supported as stricter aliases.

# Turnstile
# Turn this on only after both keys below are configured.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_API_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_COOKIE_NAME=mesh_health_turnstile
TURNSTILE_TOKEN_TTL_SECONDS=86400
TURNSTILE_BOT_BYPASS=false
TURNSTILE_BOT_ALLOWLIST=discordbot,twitterbot,slackbot,facebookexternalhit,linkedinbot,telegrambot,whatsapp
TURNSTILE_VERIFY_RATE_WINDOW_SECONDS=600
TURNSTILE_VERIFY_RATE_MAX=10
TURNSTILE_VERIFY_TIMEOUT_MS=5000
